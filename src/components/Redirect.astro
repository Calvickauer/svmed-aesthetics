---
import { u } from '../lib/site';
interface Props { to: string }
const to = u(Astro.props.to);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
  </head>
  <body><p>This page has moved. <a href={to}>Continue</a>.</p></body>
</html>
