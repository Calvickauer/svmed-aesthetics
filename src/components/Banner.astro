---
import Img from './Img.astro';
import { u } from '../lib/site';
interface Props {
  title: string;
  image?: string | null;
  crumbs?: { label: string; href?: string }[];
  align?: 'center' | 'left';
  eyebrow?: string;
  sub?: string;
  position?: string;
}
const { title, image, crumbs = [], align = 'center', eyebrow, sub, position } = Astro.props;
---
<section class:list={['banner', align]} aria-labelledby="page-title">
  {image && (
    <div class="banner-media">
      <Img src={image} alt="" sizes="100vw" priority imgClass="ken" style={position ? `object-position:${position}` : undefined} />
    </div>
  )}
  <div class="wrap banner-inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 id="page-title">{title}</h1>
    {sub && <p class="sub">{sub}</p>}
    <slot />
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href={u('/')}>Home</a></li>
          {crumbs.map((c) => (
            <li>{c.href ? <a href={u(c.href)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
  </div>
</section>
