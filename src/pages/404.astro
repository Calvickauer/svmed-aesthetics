---
import Base from '../layouts/Base.astro';
import { SITE, telHref, u } from '../lib/site';
---
<Base title="Page Not Found" description="Sorry, that page could not be found.">
  <section class="section">
    <div class="wrap wrap-narrow center" style="padding:40px 0 60px">
      <p class="eyebrow">404</p>
      <h1>Sorry, we couldn’t find that page.</h1>
      <p>It may have moved. Try one of these instead, or call us at <a href={telHref}>{SITE.phone}</a>.</p>
      <p style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:24px">
        <a class="btn" href={u('/')}>Home</a>
        <a class="btn btn-outline" href={u('/services/')}>Services</a>
        <a class="btn btn-outline" href={u('/request-appointment/')}>Book Appointment</a>
      </p>
    </div>
  </section>
</Base>
